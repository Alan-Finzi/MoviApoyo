VITE_APP_NAME=MoviApoyo
# Completar con la URL real del backend antes de desplegar a producción.
VITE_API_BASE_URL=
VITE_MAP_PROVIDER=mock
VITE_MAP_API_KEY=
VITE_WHATSAPP_PROVIDER=mock
VITE_NOTIFICATION_ENABLED=true

# Completar con el proyecto de Firebase de producción antes de desplegar
# (ver docs/firebase.md). No son secretos (viajan al bundle del cliente,
# rule 23) pero sí identifican el proyecto real.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
