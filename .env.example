VITE_APP_NAME=MoviApoyo

# URL base de la futura API. Vacío mientras el proyecto use repositorios Mock.
VITE_API_BASE_URL=

# mock | leaflet | google | mapbox
VITE_MAP_PROVIDER=mock
VITE_MAP_API_KEY=

# mock | whatsapp-business | external
VITE_WHATSAPP_PROVIDER=mock

# true | false
VITE_NOTIFICATION_ENABLED=true

# Config del proyecto de Firebase (ver docs/firebase.md). Se consigue en
# la consola de Firebase: Configuración del proyecto > Tus apps > SDK de
# Firebase. Dejar todo vacío mientras se use el modo Mock (VITE_FIREBASE_PROJECT_ID
# vacío = la app sigue usando datos en memoria, sin tocar código).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
